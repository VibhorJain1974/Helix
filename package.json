{
    "name": "helix",
    "version": "1.0.0",
    "private": true,
    "engines": {
      "node": ">=18.0.0",
      "pnpm": ">=8.0.0"
    },
    "scripts": {
      "dev":    "pnpm --parallel --filter './apps/*' dev",
      "build":  "pnpm --recursive --filter './apps/*' build",
      "vera":   "pnpm --filter vera dev",
      "verum":  "pnpm --filter verum dev",
      "ascend": "pnpm --filter ascend dev",
      "test":   "pnpm --recursive test",
      "lint":   "pnpm --recursive lint"
    }
  }